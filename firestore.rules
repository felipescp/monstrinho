rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Liberação de acesso, por e-mail. Só leitura do próprio documento.
    // Pedido de acesso: quem entrou com Google (e-mail verificado) pode criar
    // o SEU documento, sempre com ativo:false — o portão faz isso sozinho
    // quando o acesso é negado. Liberar (ativo:true), alterar ou apagar só
    // pelo console ou pelo servidor (Admin SDK).
    match /acessos/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(['ativo', 'pedidoEm'])
        && request.resource.data.ativo == false
        && request.resource.data.pedidoEm == request.time;
      allow update, delete: if false;
    }
    // Dados de estudo de cada usuário (futura troca do Gist).
    match /usuarios/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
