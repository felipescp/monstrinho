rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Liberação de acesso, por e-mail. Só leitura do próprio documento.
    // Pedido de acesso: quem entrou com Google (e-mail verificado) pode criar
    // o SEU documento, sempre com ativo:false — o portão faz isso sozinho
    // quando o acesso é negado. Liberar (ativo:true), alterar ou apagar só
    // pelo console ou pelo servidor (Admin SDK).
    match /acessos/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(['ativo', 'pedidoEm'])
        && request.resource.data.ativo == false
        && request.resource.data.pedidoEm == request.time;
      allow update, delete: if false;
    }
    // Monitoramento (medida 5): o app de cada conta soma quantos arquivos do
    // acervo (dados/) baixou no dia — um documento por conta e dia,
    // "<AAAA-MM-DD>_<uid>". A conta só cria/atualiza o próprio documento e
    // os números só podem crescer; ler, só a própria conta e a administração
    // (acessos/{e-mail}.papel == "admin"). Ninguém apaga pelo app.
    match /uso/{docId} {
      function eAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/acessos/$(request.auth.token.email)).data.get('papel', null) == 'admin';
      }
      function valido() {
        let d = request.resource.data;
        return request.auth != null
          && request.auth.token.email_verified == true
          && d.keys().hasOnly(['uid', 'email', 'dia', 'arquivos', 'bytes', 'baterias', 'atualizadoEm'])
          && d.uid == request.auth.uid
          && d.email == request.auth.token.email
          && d.dia is string && d.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && docId == d.dia + '_' + request.auth.uid
          && d.arquivos is int && d.arquivos >= 0
          && d.bytes is int && d.bytes >= 0
          && d.baterias is int && d.baterias >= 0
          && d.atualizadoEm == request.time;
      }
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || eAdmin());
      allow create: if valido();
      allow update: if valido()
        && request.resource.data.arquivos >= resource.data.arquivos
        && request.resource.data.bytes >= resource.data.bytes
        && request.resource.data.baterias >= resource.data.baterias;
      allow delete: if false;
    }
    // Dados pessoais sincronizados (SALINHA_SYNC no index.html): só o próprio
    // usuário, e só com acesso liberado (acessos/{e-mail}.ativo == true) —
    // sem isso, qualquer conta Google gravaria dados no projeto. Um documento
    // por chave tjpe_v1__…; valor inline até ~900 KB, acima disso em partes
    // (bytes). Nada fora de usuarios/{uid}/dados/{chave}[/partes/{id}].
    match /usuarios/{uid}/dados/{chave} {
      function dono() {
        return request.auth != null && request.auth.uid == uid;
      }
      // Liberado = ativo e, se houver "expiraEm" (timestamp), ainda no prazo.
      function liberado() {
        let acesso = get(/databases/$(database)/documents/acessos/$(request.auth.token.email)).data;
        return request.auth.token.email_verified == true
          && acesso.ativo == true
          && (acesso.get('expiraEm', null) == null || acesso.expiraEm > request.time);
      }
      allow read, delete: if dono() && liberado();
      allow create, update: if dono() && liberado()
        && chave.matches('tjpe_v1__[a-z0-9_]+')
        && request.resource.data.keys().hasOnly(['versao', 'partes', 'valor', 'tamanho', 'hash', 'dispositivo', 'atualizadoEm'])
        && request.resource.data.versao is number
        && request.resource.data.partes is number
        && (request.resource.data.valor == null
            || (request.resource.data.valor is string && request.resource.data.valor.size() <= 1000000));

      match /partes/{parte} {
        allow read, delete: if dono() && liberado();
        allow create, update: if dono() && liberado()
          && request.resource.data.keys().hasOnly(['versao', 'indice', 'dados'])
          && request.resource.data.dados is bytes
          && request.resource.data.dados.size() <= 950000;
      }
    }
  }
}
