rules_version = '2';
// Acervo (dados/): só para quem entrou com Google (e-mail verificado) e tem
// o documento acessos/{e-mail} no Firestore com "ativo": true (e, se tiver
// "expiraEm", ainda no prazo). Esse documento
// é criado à mão no console (laboratório) e, no futuro, pela Cloud Function
// de pagamento. Ninguém grava pelo app: o envio é feito pelo gcloud/Action.
service firebase.storage {
  match /b/{bucket}/o {
    // Níveis (ver firestore.rules, acessos/{email}): "completo" (ou sem
    // "nivel", contas de antes dos níveis) e a administração leem tudo;
    // "simples" lê só as pastas das baterias e dos materiais associados a
    // elas (Esquemas, Jurisprudência, Flashcards, Glossário), o texto das
    // leis (remissões) e os manifestos/versões dessas pastas;
    // "intermediario" lê também Prazos, Penas e os comentários da Lei Seca
    // do diploma mais cobrado de cada disciplina (lista mantida por
    // ferramentas/regras_intermediario.py).
    function acesso() {
      return firestore.get(/databases/(default)/documents/acessos/$(request.auth.token.email)).data;
    }
    function valido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && acesso().ativo == true
        && (acesso().get('expiraEm', null) == null || acesso().expiraEm > request.time);
    }
    function completo() {
      return valido() && (acesso().get('nivel', 'completo') == 'completo' || acesso().get('papel', null) == 'admin');
    }
    function simples() {
      return valido() && acesso().get('nivel', 'completo') in ['simples', 'intermediario', 'completo'];
    }
    function intermediario() {
      return valido() && (acesso().get('nivel', 'completo') in ['intermediario', 'completo'] || acesso().get('papel', null) == 'admin');
    }
    match /dados/{caminho=**} {
      allow read: if completo();
    }
    // {resto=**} também casa com zero segmentos: cobre as pastas e os
    // arquivos soltos na raiz de dados/ da lista.
    match /dados/{item}/{resto=**} {
      allow read: if item in ['bateriasvf', 'esquemas', 'jurisprudencia', 'flashcards', 'glossario', 'legislacao',
                              'manifesto-baterias.txt', 'manifesto-esquemas.txt', 'manifesto-jurisprudencia.txt',
                              'manifesto-flashcards.txt', 'manifesto-glossario.txt', 'versoes-oficiais.json']
        && simples();
    }
    // Amostra da Lei Seca no acesso simples (aberta pela bateria, só os
    // diplomas citados nela — a escolha do diploma é feita pelo app): o
    // manifesto e os mapas de incidência. Comentários do sistema, não.
    match /dados/leiseca/manifesto.json {
      allow read: if simples();
    }
    // Novidades legislativas: manchetes para todos os níveis (o resumo e os
    // atalhos ficam no completo, pela tela).
    match /dados/leiseca/novidades.json {
      allow read: if simples();
    }
    match /dados/leiseca/incidencia/{resto=**} {
      allow read: if simples();
    }
    match /dados/{item}/{resto=**} {
      allow read: if item in ['prazos', 'penas', 'manifesto-prazos.txt', 'manifesto-penas.txt'] && intermediario();
    }
    match /dados/leiseca/comentarios/{arq} {
      // INTERMEDIARIO-COMENTARIOS:INICIO
      allow read: if intermediario() && arq in ['cdc.json', 'codigo-civil.json', 'codigo-penal.json', 'cpc.json', 'cpp.json', 'eca.json', 'lei-14133.json'];
      // INTERMEDIARIO-COMENTARIOS:FIM
    }
    match /{tudo=**} {
      allow read, write: if false;
    }
  }
}
