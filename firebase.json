{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "*.rules",
      "functions/**",
      "cors.json",
      "LEIAME-firebase.md",
      "**/.*",
      "**/node_modules/**",
      "dados/**",
      "ferramentas/**",
      "relatorios/**",
      "prompts-gem/**",
      "cloudflare-worker/**",
      "Claude outputs/**",
      "taxonomia - fragmentados para prompt/**",
      "*.md",
      "*.txt",
      "*.json",
      "planner.HTML"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "teste-*.js"
      ]
    }
  ]
}
